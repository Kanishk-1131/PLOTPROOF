# PlotProof System Environment Variables Template (Layer 13)
# DO NOT COMMIT ACTUAL SECRETS TO GIT

APP_ENV=development
PORT=8000
DEBUG=false

# Database Configuration (PostgreSQL with PostGIS Extension)
DATABASE_URL=postgresql+psycopg://plotproof:password@localhost:5432/plotproof
POSTGRES_DB=plotproof
POSTGRES_USER=plotproof
POSTGRES_PASSWORD=password

# Redis Queue & Caching
REDIS_URL=redis://localhost:6379/0

# Authentication & JWT Security
JWT_SECRET=replace_me_with_cryptographically_secure_256_bit_random_hex
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage (MinIO / S3)
STORAGE_BUCKET=plotproof
STORAGE_BACKEND=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123

# Anti-Malware Scanner
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Blockchain Network Configuration (Polygon L2 / Amoy Testnet)
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
BLOCKCHAIN_CHAIN_ID=80002

# Decentralized Storage
IPFS_API_KEY=
IPFS_API_SECRET=

# Frontend Web Application URL
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
